# OCR provider: "tesseract" (default, local) or "google_vision" (cloud, better for handwriting)
OCR_PROVIDER=google_vision

# Database provider: "sqlite" (default, local) or "notion" (cloud)
DATABASE_PROVIDER=notion

# --- Google Cloud Vision (required when OCR_PROVIDER=google_vision) ---
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Notion (required when DATABASE_PROVIDER=notion) ---
# Create an integration at https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_...
# The ID of your Notion database (from the URL: notion.so/<database_id>?v=...)
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
